<%- include('partials/header') %>
<main id="conteudo" class="page-shell narrow">
  <a class="back-link" href="/">← Voltar ao painel</a>
  <% if (created) { %><div class="success-message" role="status">Incidente <strong><%= incident.identifier %></strong> criado com status Open.</div><% } %>
  <section class="detail-head reveal"><p class="eyebrow"><%= incident.identifier %> · criado em <%= incident.created_at.replace('T', ' ').slice(0, 16) %></p><div class="detail-title-row"><h1><%= incident.title %></h1><span class="badge severity-<%= incident.severity.toLowerCase() %>"><%= incident.severity %></span></div><span class="status"><i class="status-dot status-<%= incident.status.toLowerCase().replace(' ', '-') %>"></i><%= incident.status %></span></section>
  <section class="detail-grid reveal"><article><h2>Descrição</h2><p class="description"><%= incident.description %></p></article><aside><dl><div><dt>Responsável</dt><dd><%= incident.assignee %></dd></div><div><dt>Última atualização</dt><dd><%= incident.updated_at.replace('T', ' ').slice(0, 16) %></dd></div><div><dt>Status</dt><dd><%= incident.status %></dd></div></dl></aside></section>
</main>
<%- include('partials/footer') %>
