<%- include('partials/header') %>
<% const incidentComments = typeof comments !== 'undefined' && comments ? comments : []; %>
<main id="conteudo" class="page-shell detail-page">
  <div class="detail-actions"><a class="back-link" href="/">← Voltar ao painel</a><div class="detail-action-group"><a class="button button-secondary" href="/incidents/<%= incident.id %>/edit">Editar incidente</a><form method="post" action="/incidents/<%= incident.id %>/delete" onsubmit="return confirm('Excluir este incidente? Esta ação não pode ser desfeita.');"><button class="button button-danger" type="submit">Excluir incidente</button></form></div></div>
  <% if (created) { %><div class="success-message" role="status">Incidente <strong><%= incident.identifier %></strong> criado com status Open.</div><% } %>
  <% if (typeof edited !== 'undefined' && edited) { %><div class="success-message" role="status">Incidente <strong><%= incident.identifier %></strong> atualizado com sucesso.</div><% } %>
  <% if (typeof updated !== 'undefined' && updated) { %><div class="success-message" role="status">Status do incidente <strong><%= incident.identifier %></strong> atualizado com sucesso.</div><% } %>
  <% if (typeof commented !== 'undefined' && commented) { %><div class="success-message" role="status">Comentário adicionado com sucesso.</div><% } %>
  <% if (typeof error !== 'undefined' && error) { %><div class="error-summary" role="alert"><p><%= error %></p></div><% } %>
  <section class="detail-head reveal"><p class="eyebrow"><%= incident.identifier %> · criado em <%= formatDateTime(incident.created_at) %></p><div class="detail-title-row"><h1><%= incident.title %></h1><span class="badge severity-<%= incident.severity.toLowerCase() %>"><%= incident.severity %></span></div><span class="status"><i class="status-dot status-<%= incident.status.toLowerCase().replace(' ', '-') %>"></i><%= incident.status %></span></section>
  <section class="detail-grid reveal">
    <article>
      <h2>Descrição</h2>
      <p class="description"><%= incident.description %></p>
    </article>
    <aside>
      <dl>
        <div><dt>Responsável</dt><dd><%= incident.assignee %></dd></div>
        <div><dt>Data de criação</dt><dd><%= formatDateTime(incident.created_at) %></dd></div>
        <div><dt>Última atualização</dt><dd><%= formatDateTime(incident.updated_at) %></dd></div>
        <div><dt>Status atual</dt><dd><%= incident.status %></dd></div>
      </dl>
      <form class="status-form" method="post" action="/incidents/<%= incident.id %>/status">
        <fieldset class="choice-field"><legend>Alterar status</legend><div class="choice-grid choice-grid-status"><% (typeof statuses !== 'undefined' ? statuses : ['Open', 'In Progress', 'Resolved']).forEach((st) => { const statusClass = st.toLowerCase().replace(' ', '-'); %><label class="choice-card choice-status-<%= statusClass %>"><input type="radio" name="status" value="<%= st %>" <%= incident.status === st ? 'checked' : '' %> required><span class="choice-indicator" aria-hidden="true"></span><span><strong><%= st %></strong><small><%= st === 'Open' ? 'Aguardando tratamento' : st === 'In Progress' ? 'Em atendimento' : 'Tratamento concluído' %></small></span></label><% }) %></div></fieldset>
        <button class="button button-primary button-wide" type="submit">Salvar status</button>
      </form>
    </aside>
  </section>
  <section class="comments-section reveal" aria-labelledby="comments-heading">
    <div class="section-heading"><div><p class="eyebrow">Registro de atividade</p><h2 id="comments-heading">Comentários <span><%= incidentComments.length %></span></h2></div></div>
    <form class="comment-form" method="post" action="/incidents/<%= incident.id %>/comments">
      <div class="comment-form-grid"><div class="field"><label for="comment-author">Autor <span aria-hidden="true">*</span></label><input id="comment-author" name="author" value="<%= typeof commentValues !== 'undefined' && commentValues.author ? commentValues.author : '' %>" maxlength="80" required></div><div class="field"><label for="comment-content">Comentário <span aria-hidden="true">*</span></label><textarea id="comment-content" name="content" rows="3" maxlength="1000" required><%= typeof commentValues !== 'undefined' && commentValues.content ? commentValues.content : '' %></textarea></div></div>
      <button class="button button-primary" type="submit">Adicionar comentário</button>
    </form>
    <% if (incidentComments.length) { %>
      <ol class="comments-list"><% incidentComments.forEach((comment) => { %><li class="comment-item"><div class="comment-meta"><strong><%= comment.author %></strong><time datetime="<%= comment.created_at %>"><%= formatDateTime(comment.created_at) %></time></div><p><%= comment.content %></p></li><% }) %></ol>
    <% } else { %><p class="empty-comments">Nenhum comentário registrado até o momento.</p><% } %>
  </section>
  <section class="history-section reveal" aria-labelledby="history-heading">
    <h2 id="history-heading">Histórico de alterações</h2>
    <% if (typeof history !== 'undefined' && history && history.length) { %>
      <ul class="history-timeline">
        <% history.forEach((item) => { %>
          <li class="history-item">
            <time datetime="<%= item.changed_at %>"><%= formatDateTime(item.changed_at) %></time>
            <span class="history-change">
              <span class="status"><i class="status-dot status-<%= item.from_status.toLowerCase().replace(' ', '-') %>"></i><%= item.from_status %></span>
              <span class="history-arrow" aria-hidden="true">→</span>
              <span class="status"><i class="status-dot status-<%= item.to_status.toLowerCase().replace(' ', '-') %>"></i><%= item.to_status %></span>
            </span>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="empty-history">Nenhuma alteração de status registrada até o momento.</p>
    <% } %>
  </section>
</main>
<%- include('partials/footer') %>
