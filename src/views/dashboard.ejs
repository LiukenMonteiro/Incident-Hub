<%- include('partials/header') %>
<main id="conteudo" class="page-shell">
  <% if (typeof deleted !== 'undefined' && deleted) { %><div class="success-message" role="status">Incidente excluído com sucesso.</div><% } %>
  <section class="hero reveal">
    <div>
      <p class="eyebrow">Central operacional · ambiente compartilhado</p>
      <h1>Clareza para agir<br><em>no momento certo.</em></h1>
      <p class="hero-copy">Acompanhe o que exige atenção, quem está cuidando e o que já avançou — sem depender de conversas dispersas.</p>
    </div>
    <div class="hero-orbit" aria-hidden="true">
      <span class="orbit-dot dot-blue"></span><span class="orbit-dot dot-coral"></span><span class="orbit-dot dot-gold"></span>
      <span class="orbit-core">Agora</span>
    </div>
  </section>

  <section class="metrics" aria-label="Resumo dos incidentes">
    <article class="metric-card metric-blue reveal"><span>Em aberto</span><strong><%= summary.open %></strong><small>atualmente abertos</small></article>
    <article class="metric-card metric-coral reveal"><span>Críticos pendentes</span><strong><%= summary.criticalUnresolved %></strong><small>Critical não resolvidos</small></article>
    <article class="metric-card metric-gold reveal"><span>Resolvidos</span><strong><%= summary.resolved %></strong><small>concluídos com sucesso</small></article>
  </section>

  <section class="incident-section reveal" aria-labelledby="incidentes-title">
    <div class="section-heading">
      <div><p class="eyebrow">Visão geral</p><h2 id="incidentes-title">Incidentes recentes <span><%= summary.total %></span></h2></div>
      <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
        <form method="post" action="/seed-demo-data" style="margin:0;">
          <button class="button button-secondary" type="submit" aria-label="Carregar dados de teste do dashboard">Dados de teste</button>
        </form>
        <a class="text-link" href="/incidents/new">Adicionar novo <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <p class="helper-text">Use “Dados de teste” para carregar um cenário pronto e, em seguida, registre ou atualize incidentes conforme a operação da equipe.</p>
    <form class="filters" method="get" aria-label="Filtrar incidentes">
      <div class="filter-field"><label for="status-filter">Status</label><div class="filter-menu" data-filter-menu="status"><button class="filter-trigger" type="button" aria-expanded="false">Todos os status</button><div class="filter-options" role="listbox"><a href="/<%= filters.severity ? '?severity=' + encodeURIComponent(filters.severity) : '' %>" role="option" data-value="" aria-selected="<%= !filters.status ? 'true' : 'false' %>">Todos os status</a><% statuses.forEach((status) => { %><a href="/?status=<%= encodeURIComponent(status) %><%= filters.severity ? '&severity=' + encodeURIComponent(filters.severity) : '' %>" role="option" data-value="<%= status %>" aria-selected="<%= filters.status === status ? 'true' : 'false' %>"><span class="status-dot status-<%= status.toLowerCase().replace(' ', '-') %>"></span><%= status %></a><% }) %></div></div><select class="filter-native-select" id="status-filter" name="status" tabindex="-1" aria-hidden="true"><option value="">Todos os status</option><% statuses.forEach((status) => { %><option value="<%= status %>" <%= filters.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select></div>
      <div class="filter-field"><label for="severity-filter">Severidade</label><div class="filter-menu" data-filter-menu="severity"><button class="filter-trigger" type="button" aria-expanded="false">Todas as severidades</button><div class="filter-options" role="listbox"><a href="/<%= filters.status ? '?status=' + encodeURIComponent(filters.status) : '' %>" role="option" data-value="" aria-selected="<%= !filters.severity ? 'true' : 'false' %>">Todas as severidades</a><% severities.forEach((severity) => { %><a href="/?severity=<%= encodeURIComponent(severity) %><%= filters.status ? '&status=' + encodeURIComponent(filters.status) : '' %>" role="option" data-value="<%= severity %>" aria-selected="<%= filters.severity === severity ? 'true' : 'false' %>"><span class="badge severity-<%= severity.toLowerCase() %>"><%= severity %></span></a><% }) %></div></div><select class="filter-native-select" id="severity-filter" name="severity" tabindex="-1" aria-hidden="true"><option value="">Todas as severidades</option><% severities.forEach((severity) => { %><option value="<%= severity %>" <%= filters.severity === severity ? 'selected' : '' %>><%= severity %></option><% }) %></select></div>
      <button class="button button-filter" type="submit">Aplicar filtros</button>
      <span id="clear-filters-wrapper"><% if (filters.status || filters.severity) { %><a class="clear-filters" href="/">Limpar filtros</a><% } %></span>
    </form>
    <div id="incidents-results" aria-live="polite">
    <% if (incidents.length) { %>
      <div class="incident-table-wrap"><table>
        <thead><tr><th>Incidente</th><th>Severidade</th><th>Responsável</th><th>Status</th><th>Atualizado</th></tr></thead>
        <tbody><% incidents.forEach((incident) => { %><tr>
          <td><a class="incident-title" href="/incidents/<%= incident.id %>"><span><%= incident.identifier %></span><strong><%= incident.title %></strong></a></td>
          <td><span class="badge severity-<%= incident.severity.toLowerCase() %>"><%= incident.severity %></span></td>
          <td><%= incident.assignee %></td>
          <td><span class="status"><i class="status-dot status-<%= incident.status.toLowerCase().replace(' ', '-') %>"></i><%= incident.status %></span></td>
          <td><time datetime="<%= incident.updated_at %>"><%= formatDateTime(incident.updated_at) %></time></td>
        </tr><% }) %></tbody>
      </table></div>
    <% } else { %>
      <% if (filters.status || filters.severity) { %>
        <div class="empty-state"><div class="empty-symbol" aria-hidden="true">⌕</div><h3>Nenhum incidente encontrado.</h3><p>Não há registros com os filtros selecionados. Ajuste os critérios ou limpe a busca.</p><a class="button button-secondary clear-filters-btn" href="/">Limpar filtros</a></div>
      <% } else { %>
        <div class="empty-state"><div class="empty-symbol" aria-hidden="true">+</div><h3>Tudo tranquilo por aqui.</h3><p>Quando algo precisar de atenção, registre o primeiro incidente para que a equipe possa acompanhar.</p><a class="button button-secondary" href="/incidents/new">Registrar primeiro incidente</a></div>
      <% } %>
    <% } %>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
