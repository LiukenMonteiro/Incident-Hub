<%- include('partials/header') %>
<main id="conteudo" class="page-shell narrow">
  <a class="back-link" href="/">← Voltar ao painel</a>
  <section class="form-intro reveal"><p class="eyebrow">Novo registro</p><h1>Vamos dar<br><em>visibilidade ao caso.</em></h1><p>Preencha o essencial. O incidente será criado com status <strong>Open</strong>.</p></section>
  <section class="form-card reveal" aria-labelledby="form-title">
    <h2 id="form-title">Detalhes do incidente</h2>
    <% if (errors.length) { %><div class="error-summary" role="alert"><strong>Revise os campos:</strong><ul><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul></div><% } %>
    <form action="/incidents" method="post" novalidate>
      <div class="field"><label for="title">Título <span aria-hidden="true">*</span></label><input id="title" name="title" value="<%= values.title || '' %>" required autofocus></div>
      <div class="field"><label for="description">Descrição <span aria-hidden="true">*</span></label><textarea id="description" name="description" rows="5" required><%= values.description || '' %></textarea><small>Descreva o impacto e o que já se sabe.</small></div>
      <div class="form-grid"><div class="field"><label for="severity">Severidade <span aria-hidden="true">*</span></label><select id="severity" name="severity" required><option value="">Selecione</option><% severities.forEach((severity) => { %><option value="<%= severity %>" <%= values.severity === severity ? 'selected' : '' %>><%= severity %></option><% }) %></select></div><div class="field"><label for="assignee">Responsável <span aria-hidden="true">*</span></label><input id="assignee" name="assignee" value="<%= values.assignee || '' %>" required></div></div>
      <div class="form-note"><span aria-hidden="true">●</span><p>Status inicial: <strong>Open</strong>. Você poderá atualizá-lo em uma próxima etapa.</p></div>
      <button class="button button-primary button-wide" type="submit">Criar incidente <span aria-hidden="true">→</span></button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
