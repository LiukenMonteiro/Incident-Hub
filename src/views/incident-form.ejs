<%- include('partials/header') %>
<main id="conteudo" class="page-shell narrow">
  <a class="back-link" href="/">← Voltar ao painel</a>
  <section class="form-intro reveal"><p class="eyebrow">Novo registro</p><h1>Vamos dar<br><em>visibilidade ao caso.</em></h1><p>Preencha o essencial. O incidente será criado com status <strong>Open</strong>.</p></section>
  <section class="form-card reveal" aria-labelledby="form-title">
    <h2 id="form-title">Detalhes do incidente</h2>
    <% if (errors.length) { %><div class="error-summary" role="alert"><strong>Revise os campos:</strong><ul><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul></div><% } %>
    <p class="helper-text">Campos marcados com * são obrigatórios. Preencha o mínimo necessário para registrar o caso com clareza.</p>
    <form action="/incidents" method="post">
      <div class="field"><label for="title">Título <span aria-hidden="true">*</span></label><input id="title" name="title" value="<%= values.title || '' %>" maxlength="120" minlength="3" required autofocus aria-invalid="<%= errors.some((error) => error.toLowerCase().includes('título')) ? 'true' : 'false' %>"></div>
      <div class="field"><label for="description">Descrição <span aria-hidden="true">*</span></label><textarea id="description" name="description" rows="5" maxlength="1000" minlength="10" required aria-invalid="<%= errors.some((error) => error.toLowerCase().includes('descreva')) ? 'true' : 'false' %>"><%= values.description || '' %></textarea><small>Descreva o impacto, o contexto e o que já se sabe.</small></div>
      <div class="form-grid"><div class="field"><fieldset class="choice-field"><legend>Severidade <span aria-hidden="true">*</span></legend><div class="choice-grid choice-grid-severity"><% severities.forEach((severity) => { const severityClass = severity.toLowerCase(); %><label class="choice-card choice-<%= severityClass %>"><input type="radio" name="severity" value="<%= severity %>" <%= values.severity === severity ? 'checked' : '' %> required><span class="choice-indicator" aria-hidden="true"></span><span><strong><%= severity %></strong><small><%= severity === 'Critical' ? 'Resposta imediata' : severity === 'High' ? 'Impacto elevado' : severity === 'Medium' ? 'Atenção necessária' : 'Impacto limitado' %></small></span></label><% }) %></div></fieldset></div><div class="field"><label for="assignee">Responsável <span aria-hidden="true">*</span></label><input id="assignee" name="assignee" value="<%= values.assignee || '' %>" maxlength="80" minlength="2" required aria-invalid="<%= errors.some((error) => error.toLowerCase().includes('responsável')) ? 'true' : 'false' %>"></div></div>
      <div class="form-note"><span aria-hidden="true">●</span><p>Status inicial: <strong>Open</strong>. Você poderá atualizá-lo em uma próxima etapa.</p></div>
      <button class="button button-primary button-wide" type="submit">Criar incidente <span aria-hidden="true">→</span></button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
