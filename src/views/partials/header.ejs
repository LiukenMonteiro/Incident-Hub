<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#dcefff">
    <title>Incident Hub</title>
    <link rel="stylesheet" href="/styles.css">
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/filters.css">
    <script>
      (() => {
        if (localStorage.getItem('incident-hub-theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <script src="/theme.js" defer></script>
    <script src="/filters.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <div class="grain" aria-hidden="true"></div>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Incident Hub, página inicial">
        <span class="brand-mark" aria-hidden="true">i</span>
        <span>incident hub</span>
      </a>
      <div class="topbar-actions">
        <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Ativar tema escuro" title="Alternar tema">
          <span class="theme-icon" aria-hidden="true">☾</span><span class="theme-toggle-label">Tema escuro</span>
        </button>
        <a class="button button-primary" href="/incidents/new">Registrar incidente <span aria-hidden="true">↗</span></a>
      </div>
    </header>
